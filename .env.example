# Firebase — MISMO proyecto que almaagenciacreativa.com (alma-web).
# Copia estos valores exactamente iguales a los de alma-web para que la
# Academia lea/escriba la misma base de datos (cursos, recursos, estudiantes).
# Project Settings > Your apps > Web app en console.firebase.google.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Analytics 4 — mismo Measurement ID que el sitio principal (opcional)
VITE_GA_MEASUREMENT_ID=
